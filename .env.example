# VitalPower Relay configuration. Copy to .env (git-ignored): cp .env.example .env
# Node loads .env itself (npm run api / npm start use --env-file-if-exists). Synthetic data only.

# Supabase Postgres, required: the API does not start without it. Schema + synthetic seed are created on first run.
# Supabase dashboard → Connect → Session pooler (IPv4, port 5432; copy the exact host from the dashboard):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Not the direct connection: db.<project-ref>.supabase.co is IPv6-only without the paid IPv4 add-on, and neither the
# development Mac nor Vercel Functions can reach IPv6. The code works with any Supabase string; only this URL changes.
# The connection is encrypted (TLS) unless the URL has ?sslmode=... The database holds the recorded LUMA readings the
# replay depends on. Copy the SQLite demo database across once with: npm run db:migrate-sqlite -- data/vitalpower.db
DATABASE_URL=
# Tests ignore DATABASE_URL and use an in-memory PGlite. To run them on a real server instead, point this at a THROWAWAY
# database (the tests delete rows) and run one file at a time: TEST_DATABASE_URL=... node --test --test-concurrency=1 --test-force-exit
TEST_DATABASE_URL=

# API port. Vite's dev proxy (vite.config.ts) forwards /api to :3000, so change both together.
PORT=3000

# Bind address. Keep 127.0.0.1 while /call-list and /admin/* are unguarded;
# set 0.0.0.0 only after requireRole() from server/auth.ts guards them.
HOST=127.0.0.1

# Claude API key for server/ai.ts (intake extraction, reply parsing, briefing). Never commit a real key.
ANTHROPIC_API_KEY=

# NODE_ENV=production is set by `npm start` (serves dist/ from the API); leave unset in dev.

# WhatsApp through Twilio: automatic check-in plus coordinator chat (server/whatsapp.ts). No credentials = WhatsApp off.
# console.twilio.com → Account Info: the Account SID and Auth Token. The auth token also verifies every webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender. Empty = Twilio's WhatsApp sandbox number (whatsapp:+14155238886).
TWILIO_WHATSAPP_FROM=
# Public base URL of the tunnel to this API (e.g. https://abc.ngrok.app). Twilio signs against it; without it the webhooks
# refuse everything. Messaging → Try it out → WhatsApp sandbox settings → "When a message comes in":
# <PUBLIC_URL>/api/whatsapp/webhook, method POST. Delivery reports go to <PUBLIC_URL>/api/whatsapp/status on their own.
PUBLIC_URL=
# Demo: every message goes to this one phone (country code + number, e.g. 17875550000), not to the fictional seed numbers.
# That phone must first join the sandbox: send "join <your-sandbox-code>" to +1 415 523 8886 (it lasts 72 h).
WHATSAPP_DEMO_TO=
# Free text reaches a phone only within 24 h of that phone's last message to the sandbox. Outside the window the check-in
# needs an approved Content template without variables: its ContentSid (HX...). Empty = plain text.
TWILIO_CHECKIN_CONTENT_SID=
